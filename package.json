{
  "name": "portal",
  "version": "1.0.0",
  "description": "AI-powered IDE",
  "license": "MIT",
  "author": "Mike Cao <mike@mikecao.com>",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others \"node server/chat-api.mjs\" \"vite --port 3333 --strictPort\"",
    "build": "vite build",
    "start": "concurrently --kill-others \"node server/chat-api.mjs\" \"vite preview --port 3333 --strictPort\"",
    "electron:compile": "tsup electron/main.ts electron/preload.ts --format esm --outDir dist-electron --external electron",
    "electron:dev": "pnpm electron:compile && concurrently --kill-others \"vite --port 3333 --strictPort\" \"wait-on http://localhost:3333 && electron .\"",
    "electron:build": "pnpm electron:compile && vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.48",
    "@ai-sdk/openai": "^3.0.36",
    "ai": "^6.0.103",
    "ai-sdk-provider-chatgpt-oauth": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.0"
  }
}
